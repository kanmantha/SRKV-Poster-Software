@model IReadOnlyList<LogEntry>
@{
    ViewData["Title"] = "Logs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0">Activity Logs</h1>
        <p class="text-muted mb-0">@Model.Count recent entries from the scheduler, generation and publish pipeline.</p>
    </div>
    <form asp-action="Clear" method="post" onsubmit="return confirm('Clear all log entries?');">
        <button type="submit" class="btn btn-outline-danger">Clear Logs</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">📋</div>
        <h4>No activity yet</h4>
        <p>Log entries will appear here when posters are generated, scheduled or published.</p>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 180px;">Time</th>
                        <th style="width: 130px;">Level</th>
                        <th style="width: 150px;">Category</th>
                        <th>Message</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model)
                    {
                        var badge = entry.Level switch
                        {
                            "error" => "danger",
                            "warning" => "warning",
                            _ => "success"
                        };
                        <tr>
                            <td class="text-nowrap text-muted small">@entry.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><span class="badge bg-@badge text-uppercase">@entry.Level</span></td>
                            <td><span class="badge bg-secondary-subtle text-dark">@entry.Category</span></td>
                            <td>@entry.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
