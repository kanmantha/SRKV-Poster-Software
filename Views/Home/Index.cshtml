@model HomeViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="hero-card mb-4">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <p class="hero-kicker mb-1">@Model.Today.ToString("dddd, MMMM d, yyyy")</p>
            <h1 class="hero-title">Today's story, <br />turned into a poster.</h1>
            <p class="hero-sub mt-3 mb-4">
                The AI pipeline detects today's notable events, writes a caption, generates hashtags,
                and renders a share-ready poster — saved and ready to publish in one click.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Index" asp-controller="Studio" class="btn btn-lg btn-gradient">
                    ✨ Open Poster Studio
                </a>
                <form asp-action="GenerateTodayAuto" asp-controller="Home" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-lg btn-outline-light">
                        @(Model.TodaysPoster is not null ? "View Today's Poster" : "Quick Generate Today")
                    </button>
                </form>
                <a asp-action="Events" asp-controller="Home" class="btn btn-lg btn-outline-light">Preview &amp; Customize</a>
                <a asp-action="Index" asp-controller="Posters" class="btn btn-lg btn-outline-light">Gallery</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="stat-grid">
                <div class="stat-card">
                    <div class="stat-value">@Model.TotalCount</div>
                    <div class="stat-label">Total posters</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@Model.ReadyCount</div>
                    <div class="stat-label">Ready</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@Model.PublishedCount</div>
                    <div class="stat-label">Published</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">@Model.FailedCount</div>
                    <div class="stat-label">Failed</div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    var calFirst = new DateTime(Model.CalendarYear, Model.CalendarMonth, 1);
    var daysInMonth = DateTime.DaysInMonth(Model.CalendarYear, Model.CalendarMonth);
    var leadingBlanks = (int)calFirst.DayOfWeek;
    var prevMonth = calFirst.AddMonths(-1);
    var nextMonth = calFirst.AddMonths(1);
    var posterDates = Model.CalendarPosterDates.Select(d => d.Date).ToHashSet();
}

<div class="row mb-4">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <a asp-action="Index" asp-route-month="@prevMonth.Month" asp-route-year="@prevMonth.Year"
                   class="btn btn-sm btn-outline-secondary">&laquo;</a>
                <span class="fw-semibold">@calFirst.ToString("MMMM yyyy")</span>
                <a asp-action="Index" asp-route-month="@nextMonth.Month" asp-route-year="@nextMonth.Year"
                   class="btn btn-sm btn-outline-secondary">&raquo;</a>
            </div>
            <div class="card-body">
                <div class="calendar-grid">
                    <div class="cal-dow">Sun</div>
                    <div class="cal-dow">Mon</div>
                    <div class="cal-dow">Tue</div>
                    <div class="cal-dow">Wed</div>
                    <div class="cal-dow">Thu</div>
                    <div class="cal-dow">Fri</div>
                    <div class="cal-dow">Sat</div>
                    @for (var b = 0; b < leadingBlanks; b++)
                    {
                        <div class="cal-cell empty"></div>
                    }
                    @for (var day = 1; day <= daysInMonth; day++)
                    {
                        var d = new DateTime(Model.CalendarYear, Model.CalendarMonth, day);
                        var has = posterDates.Contains(d);
                        var isToday = d == Model.Today;
                        <a class="cal-cell @(has ? "has-poster" : "") @(isToday ? "today" : "")"
                           asp-controller="Studio" asp-action="Index" asp-route-date="@d.ToString("yyyy-MM-dd")" title="@d.ToString("MMMM d, yyyy")">
                            <span>@day</span>
                            @if (has)
                            {
                                <i class="cal-dot"></i>
                            }
                        </a>
                    }
                </div>
                <div class="small text-muted mt-3 d-flex gap-4">
                    <span><span class="cal-dot d-inline-block"></span> has a poster</span>
                    <span><span class="cal-today-dot d-inline-block"></span> today</span>
                    <span>Click any day to open the Studio with that date preselected.</span>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.TodaysPoster is not null)
{
    <h2 class="section-title">Today's Poster</h2>
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card poster-card h-100">
                <a asp-controller="Posters" asp-action="Details" asp-route-id="@Model.TodaysPoster.Id">
                    <img src="@Url.Action("Image", "Posters", new { id = Model.TodaysPoster.Id })"
                         class="card-img-top" alt="@Model.TodaysPoster.EventTitle" />
                </a>
                <div class="card-body">
                    <span class="badge @StatusBadgeClass(Model.TodaysPoster.Status) mb-2">@Model.TodaysPoster.Status</span>
                    <p class="card-text fw-semibold">@Model.TodaysPoster.EventTitle</p>
                    <div class="d-flex gap-2">
                        <a asp-controller="Posters" asp-action="Details" asp-route-id="@Model.TodaysPoster.Id"
                           class="btn btn-sm btn-gradient flex-fill">Open</a>
                        <partial name="_PosterShare"
                                 model='@(Model.TodaysPoster.Id,
                                          Url.Action("Image", "Posters", new { id = Model.TodaysPoster.Id }) ?? "",
                                          Model.TodaysPoster.Caption + " " + Model.TodaysPoster.Hashtags,
                                          "btn-sm btn-success flex-fill")' />
                        <a asp-controller="Posters" asp-action="DownloadImage" asp-route-id="@Model.TodaysPoster.Id"
                           class="btn btn-sm btn-outline-secondary flex-fill">Download</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Caption</h5>
                    <p class="card-text">@Model.TodaysPoster.Caption</p>
                    <p class="card-text small text-muted">@Model.TodaysPoster.Hashtags</p>
                    <hr />
                    <h6 class="text-muted text-uppercase small mb-3">Detected events</h6>
                    <ul class="list-group list-group-flush">
                        @foreach (var e in Model.TodaysPoster.Events.Take(4))
                        {
                            <li class="list-group-item px-0">
                                <span class="me-2">@((e.Year?.ToString() ?? "—"))</span> @e.Text
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
}

<h2 class="section-title">Recent Posters</h2>
@if (Model.RecentPosters.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">🎨</div>
        <h4>No posters yet</h4>
        <p>Generate your first poster to see it here.</p>
        <a asp-action="Index" asp-controller="Studio" class="btn btn-gradient">Open Poster Studio</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var poster in Model.RecentPosters)
        {
            <div class="col-sm-6 col-md-4 col-lg-2">
                <div class="card poster-card h-100">
                    <a asp-controller="Posters" asp-action="Details" asp-route-id="@poster.Id">
                        <img src="@Url.Action("Image", "Posters", new { id = poster.Id })"
                             class="card-img-top" alt="@poster.EventTitle" loading="lazy" />
                    </a>
                    <div class="card-body p-3">
                        <span class="badge @StatusBadgeClass(poster.Status)">@poster.Status</span>
                        <div class="small text-muted mt-1">@poster.EventDate.ToString("MMM d, yyyy")</div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@functions
{
    private static string StatusBadgeClass(PosterStatus status) => status switch
    {
        PosterStatus.Published => "text-bg-success",
        PosterStatus.Ready => "text-bg-primary",
        PosterStatus.Draft => "text-bg-secondary",
        PosterStatus.Failed => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}
