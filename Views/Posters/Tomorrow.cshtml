@model List<Poster>
@{
    ViewData["Title"] = "Tomorrow's Posters";
    var date = (DateTime)ViewBag.Date;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Tomorrow's Posters</h1>
        <p class="text-muted mb-0">
            Posters generated for <strong>@date.ToString("dddd, MMMM d, yyyy")</strong>.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="DownloadDay" asp-controller="Posters" asp-route-date="@date.ToString("yyyy-MM-dd")"
           class="btn btn-lg btn-gradient">Download All Posters</a>
        <a asp-action="Events" asp-controller="Home" asp-route-date="@date.ToString("yyyy-MM-dd")"
           class="btn btn-lg btn-outline-secondary">Preview Events</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">📅</div>
        <h4>No posters for tomorrow yet</h4>
        <p>Generate tomorrow's posters to see and download them here.</p>
        <a asp-action="Events" asp-controller="Home" asp-route-date="@date.ToString("yyyy-MM-dd")"
           class="btn btn-gradient">Generate Tomorrow's Posters</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var poster in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card poster-card h-100">
                    <a asp-controller="Posters" asp-action="Details" asp-route-id="@poster.Id">
                        <img src="@Url.Action("Image", "Posters", new { id = poster.Id })"
                             class="card-img-top" alt="@poster.EventTitle" loading="lazy" />
                    </a>
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="badge @StatusBadgeClass(poster.Status)">@poster.Status</span>
                            @if (!string.IsNullOrWhiteSpace(poster.TemplateName))
                            {
                                <span class="badge text-bg-secondary">@poster.TemplateName</span>
                            }
                        </div>
                        <div class="fw-semibold small mt-1">@poster.EventTitle</div>
                        <div class="d-flex gap-2 mt-2">
                            <a asp-controller="Posters" asp-action="DownloadImage" asp-route-id="@poster.Id"
                               class="btn btn-sm btn-outline-secondary flex-fill">PNG</a>
                            <a asp-controller="Posters" asp-action="Details" asp-route-id="@poster.Id"
                               class="btn btn-sm btn-gradient flex-fill">Open</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@functions
{
    private static string StatusBadgeClass(PosterStatus status) => status switch
    {
        PosterStatus.Published => "text-bg-success",
        PosterStatus.Ready => "text-bg-primary",
        PosterStatus.Draft => "text-bg-secondary",
        PosterStatus.Failed => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}
