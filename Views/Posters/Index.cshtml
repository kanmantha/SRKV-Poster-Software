@model List<Poster>
@{
    ViewData["Title"] = "Gallery";
    var filter = ViewBag.StatusFilter as PosterStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0">Poster Gallery</h1>
        <p class="text-muted mb-0">@Model.Count poster(s) — ready to download or publish.</p>
    </div>
    <a asp-controller="Home" asp-action="Events" class="btn btn-gradient">New Poster</a>
</div>

<div class="btn-group mb-4" role="group">
    <a asp-action="Index" class="btn @(filter is null ? "btn-primary" : "btn-outline-primary")">All</a>
    @foreach (var status in Enum.GetValues<PosterStatus>())
    {
        <a asp-action="Index" asp-route-status="@status"
           class="btn @(filter == status ? "btn-primary" : "btn-outline-primary")">@status</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">🖼️</div>
        <h4>Nothing here</h4>
        <p>No posters match this filter.</p>
        <a asp-controller="Home" asp-action="Events" class="btn btn-gradient">Generate a Poster</a>
    </div>
}
else
{
    <form method="post" id="galleryForm">
        @Html.AntiForgeryToken()
        <div class="gallery-toolbar d-flex align-items-center gap-2 mb-3">
            <label class="form-check-label small text-muted me-auto d-flex align-items-center gap-2 mb-0">
                <input type="checkbox" class="form-check-input m-0" id="selectAll" />
                Select all
            </label>
            <span class="small text-muted" id="selectedCount">No posters selected</span>
            <button type="submit" id="deleteSelectedBtn" formaction="@Url.Action("DeleteSelected")"
                    class="btn btn-sm btn-outline-danger" disabled
                    onclick="return confirmSelectedDelete();">Delete Selected</button>
            <button type="submit" id="deleteAllBtn" formaction="@Url.Action("DeleteAll")"
                    class="btn btn-sm btn-danger"
                    onclick="return confirmAllDelete();">Delete All</button>
        </div>

        <div class="row g-4">
            @foreach (var poster in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card poster-card h-100" data-poster-id="@poster.Id">
                        <div class="gallery-img-wrap">
                            <a asp-action="Details" asp-route-id="@poster.Id">
                                <img src="@Url.Action("Image", "Posters", new { id = poster.Id })"
                                     class="card-img-top" alt="@poster.EventTitle" loading="lazy" />
                            </a>
                            <label class="gallery-check" title="Select for delete">
                                <input type="checkbox" name="ids" value="@poster.Id" class="gallery-item-check" />
                                <span class="gallery-check-box"></span>
                            </label>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge @StatusBadgeClass(poster.Status)">@poster.Status</span>
                                @if (!string.IsNullOrWhiteSpace(poster.TemplateName))
                                {
                                    <span class="badge text-bg-secondary">@poster.TemplateName</span>
                                }
                                <small class="text-muted">@poster.EventDate.ToString("MMM d, yyyy")</small>
                            </div>
                            <p class="card-text fw-semibold small mb-0">@poster.EventTitle</p>
                            <div class="mt-3 d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@poster.Id" class="btn btn-sm btn-outline-primary flex-fill">Open</a>
                                <a asp-action="DownloadImage" asp-route-id="@poster.Id" class="btn btn-sm btn-outline-secondary flex-fill">PNG</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </form>
}

@section Scripts {
    <script>
        $(function () {
            var $all = $('#selectAll');
            var $checks = $('.gallery-item-check');
            var $count = $('#selectedCount');
            var $btn = $('#deleteSelectedBtn');

            function update() {
                var n = $checks.filter(':checked').length;
                $count.text(n === 0 ? 'No posters selected' : n + ' poster' + (n === 1 ? '' : 's') + ' selected');
                $btn.prop('disabled', n === 0);
                $all.prop('checked', n > 0 && n === $checks.length);
                $all.prop('indeterminate', n > 0 && n < $checks.length);
                $checks.each(function () {
                    $(this).closest('.poster-card').toggleClass('selected', this.checked);
                });
            }

            $all.on('change', function () {
                $checks.prop('checked', this.checked);
                update();
            });

            $checks.on('change', update);
            update();
        });

        function confirmSelectedDelete() {
            var n = document.querySelectorAll('.gallery-item-check:checked').length;
            if (n === 0) {
                return false;
            }
            return confirm('Delete ' + n + ' selected poster' + (n === 1 ? '' : 's') + '? This cannot be undone.');
        }

        function confirmAllDelete() {
            return confirm('Delete ALL posters in the gallery? This cannot be undone.');
        }
    </script>
}

@functions
{
    private static string StatusBadgeClass(PosterStatus status) => status switch
    {
        PosterStatus.Published => "text-bg-success",
        PosterStatus.Ready => "text-bg-primary",
        PosterStatus.Draft => "text-bg-secondary",
        PosterStatus.Failed => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}
