@{
    ViewData["Title"] = "Email Verification";
    var verified = ViewData["Verified"] as bool? ?? false;
    var message = ViewData["Message"] as string ?? string.Empty;
}

<div class="auth-wrap">
    <div class="auth-card text-center">
        <h1 class="auth-title">@(verified ? "Email verified" : "Verification failed")</h1>
        <p class="text-muted mb-4">@message</p>
        <a asp-action="Login" class="btn btn-gradient">Go to Sign In</a>
    </div>
</div>