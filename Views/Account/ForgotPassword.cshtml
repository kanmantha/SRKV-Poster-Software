@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1 class="auth-title">Reset your password</h1>

        @if (ViewData["Sent"] is true)
        {
            <div class="alert alert-success">If that email is registered, a reset link has been sent. Check your inbox.</div>
            <a asp-action="Login" class="btn btn-gradient w-100">Back to Sign In</a>
        }
        else
        {
            <p class="text-muted mb-4">Enter your email and we'll send you a link to set a new password.</p>
            <form asp-action="ForgotPassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-gradient w-100 py-2 fw-semibold">Send Reset Link</button>
            </form>
            <div class="text-center mt-4 small">
                <a asp-action="Login">Back to Sign In</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}